const SceneVideo: React.FC<{scene: SceneSpec}> = ({scene}) => {
  const frame = useCurrentFrame();
  const cutLength = scene.duration / 3;
  const cutIndex = Math.min(2, Math.floor(frame / cutLength));
  const cutStart = Math.floor(cutIndex * cutLength);
  const cutEnd = Math.max(cutStart + 1, Math.ceil((cutIndex + 1) * cutLength) - 1);
  const baseScales = [1.02, 1.16, 1.08];
  const targetScales = [1.1, 1.24, 1.17];
  const positions = ["50% 50%", "45% 43%", "56% 52%"];
  const opacity = interpolate(frame, [0, 5, scene.duration - 5, scene.duration], [0, 1, 1, 0], {
    extrapolateLeft: "clamp",
    extrapolateRight: "clamp",
  });

  return (
    <AbsoluteFill style={{backgroundColor: "#05030a", opacity, overflow: "hidden"}}>
      <Video
        src={staticFile(scene.src)}
        muted
        objectFit="cover"
        style={{
          width: "100%",
          height: "100%",
          objectPosition: positions[cutIndex],
          scale: interpolate(frame, [cutStart, cutEnd], [baseScales[cutIndex], targetScales[cutIndex]], {
            extrapolateLeft: "clamp",
            extrapolateRight: "clamp",
            easing: Easing.inOut(Easing.quad),
          }),
          filter: "saturate(.9) contrast(1.08) brightness(.78)",
        }}
      />
      <AbsoluteFill
        style={{
          background:
            "linear-gradient(180deg,rgba(3,2,8,.58) 0%,rgba(3,2,8,.08) 35%,rgba(3,2,8,.12) 64%,rgba(3,2,8,.82) 100%)",
        }}
      />
      <div
        style={{
          position: "absolute",
          left: 70,
          right: 70,
          top: 760,
          color: "#fff",
          fontFamily: "Arial, 'Malgun Gothic', sans-serif",
          fontWeight: 900,
          fontSize: 96,
          lineHeight: 1.08,
          letterSpacing: -5,
          textAlign: "center",
          textShadow: "0 6px 28px rgba(0,0,0,.95),0 0 36px rgba(0,0,0,.8)",
        }}
      >
        <span style={{color: scene.accent}}>{scene.emphasis}</span>
      </div>
    </AbsoluteFill>
  );
};

const NarrationCaption: React.FC = () => {
  const frame = useCurrentFrame();
  const cue = CUES.find((item) => frame >= item.startFrame && frame < item.endFrame);
  if (!cue) return null;
  const localFrame = frame - cue.startFrame;
  const opacity = interpolate(localFrame, [0, 4, Math.max(5, cue.endFrame - cue.startFrame - 5), cue.endFrame - cue.startFrame], [0, 1, 1, 0], {
    extrapolateLeft: "clamp",
    extrapolateRight: "clamp",
  });
  return (
    <div
      style={{
        position: "absolute",
        top: 190,
        left: 80,
        right: 80,
        opacity,
        padding: "22px 30px 25px",
        borderRadius: 28,
        background: "rgba(5,3,10,.64)",
        border: "1px solid rgba(216,180,254,.28)",
        color: "white",
        fontFamily: "Arial, 'Malgun Gothic', sans-serif",
        fontWeight: 900,
        fontSize: 62,
        lineHeight: 1.22,
        letterSpacing: -3,
        textAlign: "center",
        textWrap: "balance",
        textShadow: "0 4px 18px rgba(0,0,0,.95)",
      }}
    >
      {cue.text}
    </div>
  );
};

