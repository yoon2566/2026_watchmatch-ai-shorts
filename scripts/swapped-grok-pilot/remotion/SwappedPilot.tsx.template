const SceneVideo: React.FC<{scene: SceneSpec}> = ({scene}) => {
  const frame = useCurrentFrame();
  const cutLength = scene.duration / 3;
  const cutIndex = Math.min(2, Math.floor(frame / cutLength));
  const cutStart = Math.floor(cutIndex * cutLength);
  const cutEnd = Math.max(cutStart + 1, Math.ceil((cutIndex + 1) * cutLength) - 1);
  const opacity = interpolate(frame, [0, 5, scene.duration - 5, scene.duration], [0, 1, 1, 0], {extrapolateLeft: "clamp", extrapolateRight: "clamp"});
  return (
    <AbsoluteFill style={{backgroundColor: "#02070b", opacity, overflow: "hidden"}}>
      <Video
        src={staticFile(scene.src)}
        muted
        objectFit="cover"
        style={{
          width: "100%",
          height: "100%",
          objectPosition: ["50% 50%", "45% 43%", "56% 52%"][cutIndex],
          scale: interpolate(frame, [cutStart, cutEnd], [[1.02, 1.16, 1.08][cutIndex], [1.1, 1.24, 1.17][cutIndex]], {extrapolateLeft: "clamp", extrapolateRight: "clamp", easing: Easing.inOut(Easing.quad)}),
          filter: "saturate(.96) contrast(1.06) brightness(.8)",
        }}
      />
      <AbsoluteFill style={{background: "linear-gradient(180deg,rgba(1,8,12,.62) 0%,rgba(1,8,12,.05) 36%,rgba(1,8,12,.12) 63%,rgba(1,8,12,.84) 100%)"}} />
      <div style={{position: "absolute", left: 70, right: 70, top: 760, color: "#fff", fontFamily: "Arial, 'Malgun Gothic', sans-serif", fontWeight: 900, fontSize: 92, lineHeight: 1.08, letterSpacing: -5, textAlign: "center", textShadow: "0 6px 28px rgba(0,0,0,.95),0 0 36px rgba(0,0,0,.8)"}}>
        <span style={{color: scene.accent}}>{scene.emphasis}</span>
      </div>
    </AbsoluteFill>
  );
};

const NarrationCaption: React.FC = () => {
  const frame = useCurrentFrame();
  const cue = CUES.find((item) => frame >= item.startFrame && frame < item.endFrame);
  if (!cue) return null;
  const localFrame = frame - cue.startFrame;
  const duration = cue.endFrame - cue.startFrame;
  return (
    <div style={{position: "absolute", top: 185, left: 80, right: 80, opacity: interpolate(localFrame, [0, 4, Math.max(5, duration - 5), duration], [0, 1, 1, 0], {extrapolateLeft: "clamp", extrapolateRight: "clamp"}), padding: "22px 30px 25px", borderRadius: 28, background: "rgba(2,10,14,.68)", border: "1px solid rgba(125,211,252,.35)", color: "white", fontFamily: "Arial, 'Malgun Gothic', sans-serif", fontWeight: 900, fontSize: 60, lineHeight: 1.22, letterSpacing: -3, textAlign: "center", textWrap: "balance", textShadow: "0 4px 18px rgba(0,0,0,.95)"}}>
      {cue.text}
    </div>
  );
};

